[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/tutorial_panel.gd" id="1_tut"]

[node name="TutorialPanel" type="PanelContainer"]
custom_minimum_size = Vector2(0, 150)
script = ExtResource("1_tut")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.95, 0.6, 0.25, 1)
theme_override_font_sizes/font_size = 20
text = "Tutorial"

[node name="SkipButton" type="Button" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Skip tutorial"

[node name="Body" type="Label" parent="Margin/VBox"]
layout_mode = 2
autowrap_mode = 3

[node name="Goal" type="Label" parent="Margin/VBox"]
layout_mode = 2
autowrap_mode = 3
