[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/build_menu.gd" id="1_build"]

[node name="BuildMenu" type="PanelContainer"]
custom_minimum_size = Vector2(330, 0)
script = ExtResource("1_build")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Build"

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="PlannedLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Planned: nothing yet"
autowrap_mode = 3

[node name="ClearButton" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "Clear plan"
