[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/top_bar.gd" id="1_top"]

[node name="TopBar" type="PanelContainer"]
script = ExtResource("1_top")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 6

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="MoonButton" type="Button" parent="Margin/HBox"]
layout_mode = 2
tooltip_text = "Play on the Moon (starts a new game)"
toggle_mode = true
text = "Moon"

[node name="MarsButton" type="Button" parent="Margin/HBox"]
layout_mode = 2
tooltip_text = "Play on Mars (starts a new game)"
toggle_mode = true
text = "Mars"

[node name="TutorialCheck" type="CheckBox" parent="Margin/HBox"]
layout_mode = 2
tooltip_text = "Guided first 5 sols (starts a new game)"
button_pressed = true
text = "Tutorial"

[node name="SolLabel" type="Label" parent="Margin/HBox"]
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
text = "Sol 1 / 30"

[node name="PointsLabel" type="Label" parent="Margin/HBox"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "Build points: 0"

[node name="Spacer" type="Control" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="PriorityLabel" type="Label" parent="Margin/HBox"]
layout_mode = 2
text = "When power is short:"

[node name="PriorityOption" type="OptionButton" parent="Margin/HBox"]
layout_mode = 2
tooltip_text = "Which machines get power and water first when there isn't enough for all of them"

[node name="RestartButton" type="Button" parent="Margin/HBox"]
layout_mode = 2
text = "Restart"

[node name="EndSolButton" type="Button" parent="Margin/HBox"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
text = "End sol"
